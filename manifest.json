{
  "manifest_version": 3,
  "name": "Yandex Maps Photo Uploader",
  "version": "0.2.1",
  "description": "Упрощает загрузку фотографий в Яндекс Карты.",
  "host_permissions": [
    "https://yandex.ru/*",
    "https://www.yandex.ru/*",
    "https://maps.yandex.ru/*",
    "https://core-pht-proxy.maps.yandex.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://yandex.ru/maps/*",
        "https://www.yandex.ru/maps/*",
        "https://maps.yandex.ru/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "styles/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.png"
      ],
      "matches": [
        "https://yandex.ru/*",
        "https://www.yandex.ru/*",
        "https://maps.yandex.ru/*"
      ]
    }
  ]
}
